# Fill these in .env.local or the appropriate Vercel environment. Never commit values.
# Test and live should use separate database connections and release versions.
BIM_DATABASE_URL=
# Existing DATABASE_URL is used if BIM_DATABASE_URL is absent.
BIM_PAYMENT_MODE=test
BIM_STRIPE_SECRET_KEY=
BIM_STRIPE_WEBHOOK_SECRET=
BIM_STRIPE_ACCOUNT_ID=
BIM_STRIPE_PRICE_MAP={}
BIM_LICENSE_ENCRYPTION_KEY=
BIM_SITE_URL=
BIM_RELEASE_VERSION=
BIM_SUPPORT_EMAIL=
# Keep false until the documented sandbox and Revit runtime checks pass.
BIM_LIVE_APPROVED=false
