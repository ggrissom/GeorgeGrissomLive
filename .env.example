# Required for local MVP
DATABASE_URL="file:./dev.db"
ADMIN_EMAIL="admin@georgegrissom.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Public URL used for Stripe redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Enables AI catalog normalization and enrichment.
# The app still works without this key using heuristic parsing.
OPENAI_API_KEY=""

# Optional: Stripe checkout for tips, song requests, unlocks, and jukebox credits.
# The app still works without this key in demo/manual-payment mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: Better MusicBrainz identification. Required by MusicBrainz etiquette for production.
MUSICBRAINZ_CONTACT_EMAIL="booking@georgegrissom.com"
