generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                 String      @id @default(cuid())
  title              String
  startsAt           DateTime
  endsAt             DateTime?
  venueName          String
  city               String?
  state              String?
  notes              String?
  isPublic           Boolean     @default(true)
  googleCalendarId   String?
  googleEventId      String?     @unique
  googleSyncStatus   String      @default("local_only")
  googleLastSyncedAt DateTime?
  googleSyncError    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  setlists           Setlist[]
  requests           Request[]
  uploads            FanUpload[]
  recordings         Recording[]
}

model Song {
  id                   String        @id @default(cuid())
  title                String
  artist               String?
  genre                String?
  mood                 String?
  tempoLabel           String?
  requestable      Boolean   @default(true)
  rightsStatus     String?
  bpm                  Float?
  keySignature         String?
  audioUrl             String?
  minTipCents          Int           @default(0)
  freePlayLimit        Int           @default(2)
  isPublic             Boolean       @default(true)
  privateLyricsNotes   String?
  privateChordNotes    String?
  privateRehearsalNotes String?
  musicBrainzId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  setlists             SetlistSong[]
  requests             Request[]
}

model Setlist {
  id        String        @id @default(cuid())
  name      String
  venueName String
  eventId   String?
  notes     String?
  isPrivate Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  songs     SetlistSong[]
}

model SetlistSong {
  id        String   @id @default(cuid())
  setlistId String
  songId    String
  position  Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  setlist   Setlist  @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
  @@index([setlistId, position])
}

model Request {
  id              String    @id @default(cuid())
  songId          String?
  eventId         String?
  customSongTitle String?
  requesterName   String?
  message         String?
  tipAmountCents  Int       @default(0)
  promoteUrl      String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  song            Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)
  event           Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  payments        Payment[]
}

model Payment {
  id             String   @id @default(cuid())
  requestId      String?
  type           String
  amountCents    Int
  stripeSessionId String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  request        Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)
}

model ImportJob {
  id        String      @id @default(cuid())
  filename  String
  status    String      @default("pending")
  createdAt DateTime    @default(now())
  rows      ImportRow[]
}

model ImportRow {
  id        String    @id @default(cuid())
  jobId     String
  raw       String
  mapped    String?
  status    String    @default("pending")
  warning   String?
  createdAt DateTime  @default(now())
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Recording {
  id        String   @id @default(cuid())
  eventId   String?
  songId    String?
  filename  String
  mimeType  String
  notes     String?
  createdAt DateTime @default(now())
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model FanUpload {
  id           String   @id @default(cuid())
  eventId      String?
  uploaderName String?
  filename     String
  mimeType     String
  note         String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model BookingInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  date      String?
  venue     String?
  message   String?
  createdAt DateTime @default(now())
}
