{
  "name": "georgegrissomlive-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "George Grissom live music website + audience request system + admin dashboard MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run bim:typecheck",
    "start": "next start",
    "lint": "eslint src scripts tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "bim:typecheck": "tsc --project tsconfig.bim.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:py": "python -m unittest discover -s tests -p test_*.py",
    "bim:db": "tsx scripts/bim-database.ts",
    "bim:catalog": "tsx scripts/bim-stripe-catalog.ts",
    "bim:release": "tsx scripts/bim-release.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-live-audio": "tsx prisma/seed-live-audio.ts",
    "setup": "npm install && npx prisma generate && npx prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "googleapis": "^144.0.0",
    "next": "^15.0.0",
    "openai": "^4.68.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.3.1",
    "tsx": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/pg": "^8.15.5",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
